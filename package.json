{
  "name": "craftlingo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b --pretty false && vite build --config vite.config.ts",
    "preview": "npm run build && vite preview --config vite.config.ts",
    "test": "vitest run --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@litert-lm/core": "^0.14.0",
    "@wllama/wllama": "^3.5.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.46.0",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
