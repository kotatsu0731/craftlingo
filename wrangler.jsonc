{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "craftlingo",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
